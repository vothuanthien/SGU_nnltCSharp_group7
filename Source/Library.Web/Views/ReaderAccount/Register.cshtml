@model Library.Web.Models.ReaderRegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản bạn đọc";
}

<section class="reader-account-page">
    <span class="section-kicker">DỊCH VỤ BẠN ĐỌC</span>
    <div class="reader-account-card mt-3">
        <span class="reader-account-icon" aria-hidden="true">▣</span>
        <h1>Tạo tài khoản Web</h1>
        <p>Thủ thư cần tạo hồ sơ và cấp thẻ trước. Đăng ký bằng số thẻ cùng email đang lưu tại thư viện.</p>
        @if (ViewData["Error"] is string error)
        {
            <div class="alert alert-danger text-start" role="alert">@error</div>
        }
        <form asp-action="Register" method="post" class="text-start">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="CardNumber" class="form-label">Số thẻ bạn đọc</label>
                <input asp-for="CardNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email đã đăng ký tại thư viện</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Tên đăng nhập muốn tạo</label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu (ít nhất 10 ký tự)</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Tạo tài khoản</button>
        </form>
        <p class="mt-3 mb-0">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</section>
