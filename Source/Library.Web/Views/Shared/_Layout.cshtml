<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Library.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-topbar"><div class="container d-flex justify-content-between"><span>Không gian đọc và tra cứu dành cho bạn</span><span>Danh mục sách · Thư viện Sài Gòn</span></div></div>
        <nav class="navbar navbar-expand-lg navbar-light site-nav">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark">TV</span><span>Thư viện <b>Sài Gòn</b></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="catalog-heading">Danh mục</a></li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-sort="newest">Sách mới</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-availableOnly="true" asp-route-sort="available">Đang có sẵn</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Rules">Quy định mượn trả</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ReaderAccount" asp-action="History">Lịch sử mượn</a>
                        </li>
                        @if (Context.Session.GetString("ReaderToken") is not null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="MyAccount">Tài khoản (@Context.Session.GetString("ReaderName"))</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ReaderLogin">Đăng nhập</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="RegisterReader">Đăng ký bạn đọc</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Reader"))
                    {
                        <form asp-controller="ReaderAccount" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                            <span class="text-muted small">@User.Identity.Name</span>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-search-link" asp-controller="ReaderAccount" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container site-content">
        <main role="main" class="pb-3">
            @if (TempData["ReaderNotice"] is string readerNotice)
            {
                <div class="alert alert-success" role="status">@readerNotice</div>
            }
            @if (TempData["ReaderError"] is string readerError)
            {
                <div class="alert alert-warning" role="alert">@readerError</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div><a class="footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">TV</span> Thư viện Sài Gòn</a><p>Tra cứu bộ sưu tập và tình trạng sách trong thư viện.</p></div>
            <div class="footer-links"><a asp-controller="Home" asp-action="Index" asp-fragment="catalog-heading">Danh mục sách</a><a asp-controller="Home" asp-action="Rules">Quy định mượn và trả</a><a asp-controller="ReaderAccount" asp-action="History">Lịch sử mượn</a></div>
            <div class="footer-copy">&copy; 2026 Thư viện Sài Gòn<br /><span>Hệ thống tra cứu thư viện</span></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
