@model Library.Web.Controllers.BookDetailsVm
@{
    ViewData["Title"] = Model.title;
    var coverClass = $"cover-{Model.id % 6 + 1}";
    var readerLoggedIn = Context.Session.GetString("ReaderToken") is not null || User.IsInRole("Reader");
}

<a asp-action="Index" class="back-link">← <span>Quay lại danh mục sách</span></a>
<article class="book-detail p-3 p-md-5 rounded-4 mt-3">
    <div class="book-cover detail-cover @coverClass" aria-label="Bìa minh họa @Model.title">
        <span class="cover-library">THƯ VIỆN SÀI GÒN</span>
        <span class="cover-category">@Model.genre</span>
        <strong>@Model.title</strong>
        <span class="cover-author">@(Model.authors.FirstOrDefault() ?? "Tác giả đang cập nhật")</span>
        <span class="cover-emblem">✳</span>
    </div>
    <div class="detail-content">
        <span class="section-kicker">CHI TIẾT ĐẦU SÁCH</span>
        <h1 class="mt-3">@Model.title</h1>
        <p class="detail-author">@(Model.authors.Count == 0 ? "Chưa cập nhật tác giả" : string.Join(", ", Model.authors))</p>

        <div class="detail-data">
            <div><dt>Thể loại</dt><dd>@Model.genre</dd></div>
            <div><dt>Năm xuất bản</dt><dd>@(Model.year?.ToString() ?? "Chưa cập nhật")</dd></div>
            <div><dt>ISBN</dt><dd>@(Model.isbn ?? "Chưa cập nhật")</dd></div>
            <div><dt>Nhà xuất bản</dt><dd>@Model.publisher</dd></div>
        </div>

        <div class="availability-panel @(Model.available > 0 ? "" : "empty")">
            <span aria-hidden="true">@(Model.available > 0 ? "✓" : "–")</span>
            <div><strong>@(Model.available > 0 ? $"{Model.available} bản sao đang sẵn có" : "Hiện chưa có bản sao sẵn sàng")</strong><span>@(Model.available > 0 ? "Bạn có thể gửi yêu cầu mượn hoặc đặt trước một bản để nhận tại thư viện." : "Bạn có thể đặt trước để xếp hàng chờ bản sao được trả.")</span></div>
        </div>

        @if (TempData["ReservationSuccess"] is string success)
        {
            <div class="alert alert-success mt-3" role="status">@success</div>
        }
        @if (TempData["ReservationError"] is string error)
        {
            <div class="alert alert-warning mt-3" role="alert">@error</div>
        }
        @if (TempData["LoanRequestSuccess"] is string loanSuccess)
        {
            <div class="alert alert-success mt-3" role="status">@loanSuccess</div>
        }
        @if (TempData["LoanRequestError"] is string loanError)
        {
            <div class="alert alert-warning mt-3" role="alert">@loanError</div>
        }
        @if (Model.available > 0)
        {
            @if (readerLoggedIn)
            {
                <form asp-action="RequestLoan" asp-route-id="@Model.id" method="post" class="reservation-form mt-3">
                    @Html.AntiForgeryToken()
                    <p class="mb-2">Muốn mượn ngay? Gửi yêu cầu để thủ thư xác nhận bản sao và lập phiếu.</p>
                    <button type="submit" class="btn btn-primary">Yêu cầu mượn sách</button>
                </form>
            }
            else
            {
                <div class="reservation-form mt-3"><p class="mb-2">Đăng nhập để gửi yêu cầu mượn sách này.</p><a asp-controller="ReaderAccount" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = Model.id })" class="btn btn-primary">Đăng nhập để mượn</a></div>
            }
        }
        @if (readerLoggedIn)
        {
            <form asp-action="Reserve" asp-route-id="@Model.id" method="post" class="reservation-form mt-3">
                @Html.AntiForgeryToken()
                <p class="mb-2">Muốn giữ sách để đến nhận tại thư viện? Đặt trước sẽ giữ bản trong 3 ngày sau khi thủ thư xác nhận.</p>
                <button type="submit" class="btn btn-outline-primary">Đặt trước sách</button>
                <small class="form-text">@(Model.available > 0 ? "Có thể đặt trước dù sách đang còn bản; thủ thư sẽ giữ một bản cho bạn." : "Bạn sẽ được xếp hàng chờ đến khi có bản sao được trả.") Mỗi thẻ chỉ có một yêu cầu đang hoạt động cho mỗi đầu sách.</small>
            </form>
        }
        else
        {
            <div class="reservation-form mt-3"><p class="mb-2">Đăng nhập bằng tài khoản bạn đọc để gửi yêu cầu mượn hoặc đặt trước sách.</p><a asp-controller="ReaderAccount" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = Model.id })" class="btn btn-outline-primary">Đăng nhập để đặt trước</a></div>
        }

        <section class="description-block">
            <h2>Giới thiệu sách</h2>
            <p>@(string.IsNullOrWhiteSpace(Model.description) ? "Thư viện chưa cập nhật phần giới thiệu cho sách này." : Model.description)</p>
        </section>
        <a asp-action="Index" class="btn btn-outline-success mt-2">Tiếp tục khám phá sách <span aria-hidden="true">→</span></a>
    </div>
</article>
