@model Library.Web.Controllers.BookDetailsVm
@{ ViewData["Title"] = Model.title; }
<a asp-action="Index" class="btn btn-link px-0">← Quay lại danh mục</a>
<article class="book-detail p-4 p-md-5 rounded-4"><span class="badge text-bg-light">@Model.genre</span><h1 class="mt-3">@Model.title</h1>
    <p class="lead">@(Model.authors.Count == 0 ? "Chưa cập nhật tác giả" : string.Join(", ", Model.authors))</p>
    <dl class="row mt-4"><dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@(Model.isbn ?? "Chưa cập nhật")</dd><dt class="col-sm-3">Năm xuất bản</dt><dd class="col-sm-9">@(Model.year?.ToString() ?? "Chưa cập nhật")</dd><dt class="col-sm-3">Nhà xuất bản</dt><dd class="col-sm-9">@Model.publisher</dd><dt class="col-sm-3">Bản sao sẵn có</dt><dd class="col-sm-9">@Model.available</dd></dl>
    <h2 class="h5 mt-4">Giới thiệu</h2><p class="mb-0">@(string.IsNullOrWhiteSpace(Model.description) ? "Thư viện chưa cập nhật phần giới thiệu cho sách này." : Model.description)</p>
</article>
