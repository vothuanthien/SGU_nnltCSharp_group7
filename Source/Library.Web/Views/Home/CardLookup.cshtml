@{
    ViewData["Title"] = "Thông tin tài khoản bạn đọc";
}

<section class="reader-account-page">
    <span class="section-kicker">DỊCH VỤ BẠN ĐỌC</span>
    <div class="reader-account-card mt-3">
        <span class="reader-account-icon" aria-hidden="true">▣</span>
        <h1>Thông tin mượn sách cá nhân</h1>
        <p>Để bảo vệ thông tin thẻ và lịch sử mượn, website hiện chưa hỗ trợ đăng nhập bạn đọc. Không nhập số thẻ trên trang công khai.</p>
        <p>Vui lòng liên hệ thủ thư tại quầy để được tra cứu hồ sơ và các sách đang mượn.</p>
        <a asp-action="Index" class="btn btn-primary mt-2">Tiếp tục tra cứu sách</a>
    </div>
</section>
