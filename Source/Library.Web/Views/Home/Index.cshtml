@model IEnumerable<Library.Web.Controllers.BookVm>
@{ ViewData["Title"] = "Tra cứu sách"; var genres = ViewBag.Genres as List<Library.Web.Controllers.GenreVm> ?? []; }
<section class="hero p-4 p-md-5 rounded-4 mb-4">
    <p class="eyebrow">THƯ VIỆN SÀI GÒN · KHÔNG GIAN TRI THỨC</p>
    <h1>Khám phá cuốn sách tiếp theo của bạn</h1>
    <p>Tìm theo tên sách, tác giả hoặc ISBN; chọn thể loại để thu hẹp kết quả.</p>
    <!-- Form GET giúp bạn đọc chia sẻ hoặc lưu lại đường dẫn tìm kiếm. -->
    <form method="get" asp-action="Index" class="row g-2">
        <div class="col-md"><input name="q" value="@ViewBag.Query" class="form-control form-control-lg" placeholder="Tên sách, tác giả, ISBN" aria-label="Từ khóa tìm sách" /></div>
        <div class="col-md-4"><select name="genreId" class="form-select form-select-lg"><option value="">Tất cả thể loại</option>@foreach (var genre in genres) { <option value="@genre.id" selected="@(ViewBag.GenreId == genre.id)">@genre.name</option> }</select></div>
        <div class="col-md-auto"><button class="btn btn-primary btn-lg w-100">Tìm sách</button></div>
    </form>
</section>
@if (ViewBag.ApiError is not null) { <div class="alert alert-warning" role="status">@ViewBag.ApiError</div> }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Danh mục sách</h2><span class="text-secondary">@ViewBag.Total kết quả · trang @ViewBag.Page</span></div>
@if (!Model.Any() && ViewBag.ApiError is null) { <p class="alert alert-light">Không tìm thấy sách phù hợp. Thử từ khóa hoặc thể loại khác.</p> }
<div class="row g-3">
@foreach (var book in Model) {
    <div class="col-sm-6 col-lg-4"><article class="card h-100 shadow-sm"><div class="card-body d-flex flex-column">
        <span class="badge text-bg-light align-self-start">@book.genre</span><h3 class="h5 mt-3">@book.title</h3>
        <p class="text-secondary mb-1">@(book.authors.Count == 0 ? "Chưa cập nhật tác giả" : string.Join(", ", book.authors))</p>
        <p class="text-secondary">ISBN: @(book.isbn ?? "Chưa cập nhật") · @(book.year?.ToString() ?? "Năm chưa rõ")</p>
        <p class="mb-3">Bản sao sẵn có: <strong>@book.available</strong></p>
        <a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@book.id">Xem chi tiết</a>
    </div></article></div>
}
</div>
<!-- Giữ nguyên bộ lọc khi chuyển trang để kết quả duyệt danh mục nhất quán. -->
@if (ViewBag.Total is int total && total > 12) { <nav class="mt-4" aria-label="Phân trang"><ul class="pagination justify-content-center">
    @for (var p = 1; p <= Math.Ceiling(total / 12.0); p++) { <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-genreId="@ViewBag.GenreId" asp-route-page="@p">@p</a></li> }
</ul></nav> }
