# Sao chép thành .env rồi đổi giá trị:  copy .env.example .env
# KHÔNG commit file .env thật. Mật khẩu SA cần >= 8 ký tự, có chữ hoa, chữ thường, số;
# không dùng ký tự ; hoặc = vì được ghép vào connection string.
MSSQL_SA_PASSWORD=DoiMatKhau_SA_123
# Mật khẩu tài khoản 'admin' do API tạo ở lần chạy đầu (>= 8 ký tự). Để trống thì không tạo admin.
ADMIN_PASSWORD=DoiMatKhau_Admin_123
# Cổng trên máy Windows
API_HOST_PORT=5001
SQL_HOST_PORT=14333
